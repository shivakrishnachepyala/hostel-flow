# ==============================================================================
# HostelFlow Backend - Production & Development Environment Configuration
# ==============================================================================

# Flask Server Settings
FLASK_SECRET_KEY=replace-with-a-random-secret-key-32-chars-minimum
FLASK_DEBUG=False
PORT=5000
HOST=127.0.0.1

# MySQL Database Connection Settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=hms

# Database Connection Pool Settings
DB_POOL_NAME=hms_pool
DB_POOL_SIZE=10

# Optional SSL / TLS Settings for Remote Cloud Database (e.g., Aiven, AWS RDS)
DB_SSL_CA=
DB_SSL_VERIFY=False

# Allowed CORS Origins (comma-separated, explicitly configured; no wildcards in prod)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app

# JWT Authentication Settings (Phase 3 Authentication)
JWT_SECRET_KEY=replace-with-a-secure-jwt-signing-key
JWT_ACCESS_TOKEN_EXPIRES=28800
